package com.klef.soa.exam.service;

import java.util.List;
import java.util.Optional;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.klef.soa.exam.entity.InternetPlanEntity;
import com.klef.soa.exam.repository.InternetPlanRepository;

@Service
public class InternetPlanServiceImpl implements Interne{

	@Autowired
	InternetPlanRepository repo;
	
	public void add(InternetPlanEntity entity) {
		repo.save(entity);
	}
	
	public List<InternetPlanEntity> display(){
		return repo.findAll();
	}
	
	public String delete(Long id) {
		Optional<InternetPlanEntity> entity=repo.findById(id);
		if(entity==null) {
			return "User with this id does not exist";
		}
		return "User deleted successfully";
	}
}
